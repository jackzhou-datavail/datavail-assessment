{
  "datasets": [
    {
      "name": "ds_overall",
      "displayName": "Overall Onboarding Score",
      "queryLines": [
        "SELECT\n",
        "  s.overall_score,\n",
        "  s.coverage_pct,\n",
        "  s.confidence,\n",
        "  s.critical_gaps,\n",
        "  s.n_measured,\n",
        "  s.n_not_available,\n",
        "  s.n_not_applicable,\n",
        "  s.n_patterns,\n",
        "  CASE\n",
        "    WHEN s.coverage_pct < 40 THEN 'INSUFFICIENT DATA'\n",
        "    WHEN s.overall_score >= 80 THEN 'GOOD'\n",
        "    WHEN s.overall_score >= 60 THEN 'FAIR'\n",
        "    ELSE 'POOR'\n",
        "  END AS onboarding_grade,\n",
        "  r.run_ts,\n",
        "  r.lookback_days,\n",
        "  r.registry_version\n",
        "FROM assessment.results.assessment_score s\n",
        "JOIN assessment.results.assessment_run r ON r.run_id = s.run_id\n",
        "WHERE s.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n"
      ]
    },
    {
      "name": "ds_category",
      "displayName": "Category Readiness",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  ROUND(weighted_score, 1) AS score,\n",
        "  ROUND(coverage_pct, 1)   AS coverage_pct,\n",
        "  n_measured,\n",
        "  n_not_available,\n",
        "  n_not_applicable,\n",
        "  n_poor,\n",
        "  CASE\n",
        "    WHEN coverage_pct < 40 THEN 'INSUFFICIENT DATA'\n",
        "    WHEN weighted_score >= 80 THEN 'GOOD'\n",
        "    WHEN weighted_score >= 60 THEN 'FAIR'\n",
        "    ELSE 'POOR'\n",
        "  END AS implementation\n",
        "FROM assessment.results.category_score\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n"
      ]
    },
    {
      "name": "ds_checks",
      "displayName": "Measured Checks",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  pattern_id,\n",
        "  title,\n",
        "  severity,\n",
        "  grade,\n",
        "  ROUND(conformance_pct, 1) AS conformance_pct,\n",
        "  numerator,\n",
        "  denominator,\n",
        "  unit,\n",
        "  finding_count,\n",
        "  CASE severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2\n",
        "                WHEN 'MEDIUM' THEN 3 ELSE 4 END AS severity_rank\n",
        "FROM assessment.results.v_latest_report\n",
        "WHERE status = 'MEASURED'\n"
      ]
    },
    {
      "name": "ds_gaps",
      "displayName": "Priority Remediation",
      "queryLines": [
        "SELECT\n",
        "  severity,\n",
        "  category,\n",
        "  pattern_id,\n",
        "  title,\n",
        "  ROUND(conformance_pct, 1) AS conformance_pct,\n",
        "  grade,\n",
        "  CONCAT(CAST(numerator AS STRING), ' / ', CAST(denominator AS STRING), ' ', unit) AS coverage_detail,\n",
        "  finding_count,\n",
        "  doc_path\n",
        "FROM assessment.results.v_latest_report\n",
        "WHERE status = 'MEASURED' AND grade IN ('POOR', 'FAIR')\n",
        "ORDER BY\n",
        "  CASE severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2\n",
        "                WHEN 'MEDIUM' THEN 3 ELSE 4 END,\n",
        "  conformance_pct\n"
      ]
    },
    {
      "name": "ds_findings",
      "displayName": "Evidence",
      "queryLines": [
        "SELECT\n",
        "  f.pattern_id,\n",
        "  reg.category,\n",
        "  reg.severity,\n",
        "  f.object_type,\n",
        "  f.object_name,\n",
        "  f.owner,\n",
        "  f.metric_name,\n",
        "  f.metric_value\n",
        "FROM assessment.results.check_finding f\n",
        "JOIN assessment.results.pattern_registry reg\n",
        "  ON reg.run_id = f.run_id AND reg.pattern_id = f.pattern_id\n",
        "WHERE f.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n",
        "ORDER BY f.metric_value DESC NULLS LAST\n"
      ]
    },
    {
      "name": "ds_status",
      "displayName": "Measurement Status",
      "queryLines": [
        "SELECT status, COUNT(*) AS n_patterns\n",
        "FROM assessment.results.check_result\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n",
        "GROUP BY status\n"
      ]
    },
    {
      "name": "ds_blindspots",
      "displayName": "Blind Spots",
      "queryLines": [
        "SELECT\n",
        "  reg.check_tier,\n",
        "  reg.severity,\n",
        "  reg.category,\n",
        "  res.pattern_id,\n",
        "  reg.title,\n",
        "  res.reason\n",
        "FROM assessment.results.check_result res\n",
        "JOIN assessment.results.pattern_registry reg\n",
        "  ON reg.run_id = res.run_id AND reg.pattern_id = res.pattern_id\n",
        "WHERE res.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1) AND res.status = 'NOT_AVAILABLE'\n",
        "ORDER BY\n",
        "  CASE reg.severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2 ELSE 3 END,\n",
        "  reg.check_tier\n"
      ]
    },
    {
      "name": "ds_tier",
      "displayName": "Coverage by Tier",
      "queryLines": [
        "SELECT\n",
        "  reg.check_tier,\n",
        "  COUNT(*) AS n_patterns,\n",
        "  SUM(CASE WHEN res.status = 'MEASURED' THEN 1 ELSE 0 END) AS n_measured\n",
        "FROM assessment.results.check_result res\n",
        "JOIN assessment.results.pattern_registry reg\n",
        "  ON reg.run_id = res.run_id AND reg.pattern_id = res.pattern_id\n",
        "WHERE res.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n",
        "GROUP BY reg.check_tier\n"
      ]
    }
  ],
