{
  "datasets": [
    {
      "name": "ds_scores_today",
      "displayName": "Health Scores (Today)",
      "queryLines": [
        "SELECT dimension, score, score_delta_30d,\n  CASE WHEN score < 60 THEN 'critical' WHEN score < 75 THEN 'warning' ELSE 'healthy' END AS score_band\nFROM gold_health_scores WHERE report_date = CURRENT_DATE()"
      ]
    },
    {
      "name": "ds_kpis",
      "displayName": "Overview KPIs",
      "queryLines": [
        "SELECT\n  (SELECT score FROM gold_health_scores WHERE report_date = CURRENT_DATE() AND dimension = 'overall') AS overall_score,\n  (SELECT COUNT(*) FROM gold_remediation_backlog WHERE severity = 'critical') AS critical_findings,\n  (SELECT COUNT(*) FROM gold_remediation_backlog WHERE severity = 'high') AS high_findings,\n  (SELECT COUNT(*) FROM raw_ws_pipelines WHERE has_owner_tag = false) AS pipelines_no_owner"
      ]
    },
    {
      "name": "ds_etl_trend",
      "displayName": "ETL Hygiene Score Trend",
      "queryLines": [
        "SELECT report_date, score FROM gold_health_scores WHERE dimension = 'etl_hygiene' ORDER BY report_date"
      ]
    },
    {
      "name": "ds_critical_backlog",
      "displayName": "Critical Findings",
      "queryLines": [
        "SELECT severity, category, asset_name, description, business_impact_usd, recommended_action\nFROM gold_remediation_backlog WHERE severity = 'critical' ORDER BY business_impact_usd DESC"
      ]
    },
    {
      "name": "ds_bronze_edits",
      "displayName": "Bronze Table Edits",
      "queryLines": [
        "SELECT table_name, edit_count_90d, severity, downstream_gold_table_count, estimated_rerun_cost_usd\nFROM gold_bronze_table_edits ORDER BY edit_count_90d DESC"
      ]
    },
    {
      "name": "ds_bronze_edits_critical",
      "displayName": "Critical Bronze Table Edits",
      "queryLines": [
        "SELECT table_name, edit_count_90d, downstream_gold_table_count, estimated_rerun_cost_usd\nFROM gold_bronze_table_edits WHERE severity = 'critical' ORDER BY estimated_rerun_cost_usd DESC"
      ]
    },
    {
      "name": "ds_pipeline_failures",
      "displayName": "Pipeline Failure Rates",
      "queryLines": [
        "SELECT pipeline_name, failure_rate_30d, health_status FROM gold_pipeline_health\nWHERE failure_rate_30d > 0 ORDER BY failure_rate_30d DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_pipeline_ownership",
      "displayName": "Production Pipeline Ownership",
      "queryLines": [
        "SELECT CASE WHEN has_owner_tag THEN 'Owned' ELSE 'Unowned' END AS ownership_status, COUNT(*) AS pipeline_count\nFROM gold_pipeline_health WHERE is_production = TRUE GROUP BY has_owner_tag"
      ]
    },
    {
      "name": "ds_ownership_trend_long",
      "displayName": "Ownership Coverage Trend",
      "queryLines": [
        "SELECT report_date, 'Actual' AS series, ownership_coverage_pct AS coverage_pct FROM gold_ownership_trend\nUNION ALL\nSELECT report_date, 'Goal' AS series, goal_pct AS coverage_pct FROM gold_ownership_trend\nORDER BY report_date"
      ]
    },
    {
      "name": "ds_backlog",
      "displayName": "Full Remediation Backlog",
      "queryLines": [
        "SELECT finding_id, severity, category, asset_type, asset_name, owner_email, description,\n  business_impact_usd, recommended_action, sprint_estimate_days\nFROM gold_remediation_backlog\nORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 ELSE 3 END, business_impact_usd DESC"
      ]
    },
    {
      "name": "ds_backlog_kpis",
      "displayName": "Backlog KPIs",
      "queryLines": [
        "SELECT\n  (SELECT COUNT(*) FROM gold_remediation_backlog WHERE severity = 'critical') AS critical_count,\n  (SELECT COUNT(*) FROM gold_remediation_backlog WHERE severity = 'high') AS high_count,\n  (SELECT COUNT(*) FROM gold_remediation_backlog WHERE severity = 'medium') AS medium_count"
      ]
    }
  ],
