{
  "datasets": [
    {
      "name": "adopt_overall",
      "displayName": "Adoption Overall",
      "queryLines": [
        "SELECT\n",
        "  score_pct        AS overall_pct,\n",
        "  grade            AS overall_grade,\n",
        "  points,\n",
        "  max_points,\n",
        "  active_count,\n",
        "  minimal_count,\n",
        "  none_count,\n",
        "  not_measurable_count,\n",
        "  coverage_pct,\n",
        "  run_ts\n",
        "FROM assessment.results.adoption_section_score\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.adoption_section_score ORDER BY run_ts DESC LIMIT 1) AND section = 'OVERALL'\n"
      ]
    },
    {
      "name": "adopt_sections",
      "displayName": "Adoption by Section",
      "queryLines": [
        "SELECT\n",
        "  section,\n",
        "  score_pct,\n",
        "  grade,\n",
        "  points,\n",
        "  max_points,\n",
        "  active_count,\n",
        "  minimal_count,\n",
        "  none_count,\n",
        "  not_measurable_count,\n",
        "  coverage_pct,\n",
        "  weight\n",
        "FROM assessment.results.adoption_section_score\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.adoption_section_score ORDER BY run_ts DESC LIMIT 1) AND section <> 'OVERALL'\n"
      ]
    },
    {
      "name": "adopt_checks",
      "displayName": "Adoption Checks",
      "queryLines": [
        "SELECT\n",
        "  section,\n",
        "  check_id,\n",
        "  check_name,\n",
        "  label,\n",
        "  score,\n",
        "  raw_value,\n",
        "  COALESCE(detail, '') AS detail,\n",
        "  CASE WHEN measurable = FALSE THEN 'not observable'\n",
        "       WHEN error IS NOT NULL THEN 'query failed'\n",
        "       ELSE 'measured' END AS measurable\n",
        "FROM assessment.results.adoption_check_history\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.adoption_section_score ORDER BY run_ts DESC LIMIT 1)\n",
        "ORDER BY check_id\n"
      ]
    },
    {
      "name": "adopt_label_mix",
      "displayName": "Check Mix by Section",
      "queryLines": [
        "SELECT section, label, COUNT(*) AS n_checks\n",
        "FROM assessment.results.adoption_check_history\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.adoption_section_score ORDER BY run_ts DESC LIMIT 1)\n",
        "GROUP BY section, label\n"
      ]
    },
    {
      "name": "adopt_gaps",
      "displayName": "Unused Capabilities",
      "queryLines": [
        "SELECT\n",
        "  section,\n",
        "  check_id,\n",
        "  check_name,\n",
        "  raw_value,\n",
        "  COALESCE(error, '') AS error\n",
        "FROM assessment.results.adoption_check_history\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.adoption_section_score ORDER BY run_ts DESC LIMIT 1) AND score = 0 AND measurable = TRUE\n",
        "ORDER BY section, check_id\n"
      ]
    },
    {
      "name": "ds_overall",
      "displayName": "Overall Onboarding Score",
      "queryLines": [
        "SELECT\n",
        "  s.overall_score,\n",
        "  s.coverage_pct,\n",
        "  s.confidence,\n",
        "  s.critical_gaps,\n",
        "  s.n_measured,\n",
        "  s.n_not_available,\n",
        "  s.n_not_applicable,\n",
        "  s.n_patterns,\n",
        "  CASE\n",
        "    WHEN s.coverage_pct < 40 THEN 'INSUFFICIENT DATA'\n",
        "    WHEN s.overall_score >= 80 THEN 'GOOD'\n",
        "    WHEN s.overall_score >= 60 THEN 'FAIR'\n",
        "    ELSE 'POOR'\n",
        "  END AS onboarding_grade,\n",
        "  r.run_ts,\n",
        "  r.lookback_days,\n",
        "  r.registry_version\n",
        "FROM assessment.results.assessment_score s\n",
        "JOIN assessment.results.assessment_run r ON r.run_id = s.run_id\n",
        "WHERE s.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n"
      ]
    },
    {
      "name": "ds_category",
      "displayName": "Category Readiness",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  ROUND(weighted_score, 1) AS score,\n",
        "  ROUND(coverage_pct, 1)   AS coverage_pct,\n",
        "  n_measured,\n",
        "  n_not_available,\n",
        "  n_not_applicable,\n",
        "  n_poor,\n",
        "  CASE\n",
        "    WHEN coverage_pct < 40 THEN 'INSUFFICIENT DATA'\n",
        "    WHEN weighted_score >= 80 THEN 'GOOD'\n",
        "    WHEN weighted_score >= 60 THEN 'FAIR'\n",
        "    ELSE 'POOR'\n",
        "  END AS implementation\n",
        "FROM assessment.results.category_score\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n"
      ]
    }
  ],
