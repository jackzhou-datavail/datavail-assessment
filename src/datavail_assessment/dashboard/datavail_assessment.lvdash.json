                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "overall_pct",
                  "displayName": "Adoption Score"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Adoption Score",
                "showDescription": true,
                "description": "Section percentages, weighted by section"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 3,
            "height": 5
          }
        },
