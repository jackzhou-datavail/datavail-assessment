{
  "datasets": [
    {
      "name": "ds_status",
      "displayName": "Measurement Status",
      "queryLines": [
        "SELECT status, COUNT(*) AS n_patterns\n",
        "FROM assessment.results.check_result\n",
        "WHERE run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n",
        "GROUP BY status\n"
      ]
    },
    {
      "name": "ds_blindspots",
      "displayName": "Blind Spots",
      "queryLines": [
        "SELECT\n",
        "  reg.check_tier,\n",
        "  reg.severity,\n",
        "  reg.category,\n",
        "  res.pattern_id,\n",
        "  reg.title,\n",
        "  res.reason\n",
        "FROM assessment.results.check_result res\n",
        "JOIN assessment.results.pattern_registry reg\n",
        "  ON reg.run_id = res.run_id AND reg.pattern_id = res.pattern_id\n",
        "WHERE res.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1) AND res.status = 'NOT_AVAILABLE'\n",
        "ORDER BY\n",
        "  CASE reg.severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2 ELSE 3 END,\n",
        "  reg.check_tier\n"
      ]
    },
    {
      "name": "ds_tier",
      "displayName": "Outcome by Tier",
      "queryLines": [
        "SELECT\n",
        "  reg.check_tier,\n",
        "  CASE\n",
        "    WHEN res.status = 'MEASURED'       THEN 'Measured'\n",
        "    WHEN res.status = 'NOT_APPLICABLE' THEN 'Nothing in scope'\n",
        "    WHEN res.status = 'ERROR'          THEN 'Error'\n",
        "    WHEN reg.implemented               THEN 'Check ran, no data'\n",
        "    ELSE 'No check written'\n",
        "  END AS outcome,\n",
        "  COUNT(*) AS n_checks\n",
        "FROM assessment.results.check_result res\n",
        "JOIN assessment.results.pattern_registry reg\n",
        "  ON reg.run_id = res.run_id AND reg.pattern_id = res.pattern_id\n",
        "WHERE res.run_id = (SELECT run_id FROM assessment.results.assessment_run WHERE status = 'COMPLETE' ORDER BY run_ts DESC LIMIT 1)\n",
        "GROUP BY 1, 2\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "coverage",
      "displayName": "Conformance: Coverage & Blind Spots",
      "layout": [
        {
          "widget": {
            "name": "p3_title",
            "multilineTextboxSpec": {
              "lines": [
                "## Coverage and Blind Spots\n",
                "\n",
                "What this assessment could **not** see, and why. Every check without a result carries a reason: a system schema that is not enabled, a missing grant, a renamed column, or a tier needing an API this collector does not call.\n",
                "\n",
                "This page exists so the headline score is never mistaken for a complete review.\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "status_pie",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_status",
                  "fields": [
                    {
                      "name": "status",
                      "expression": "`status`"
                    },
                    {
                      "name": "n_patterns",
                      "expression": "`n_patterns`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "n_patterns",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "status",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "MEASURED",
                        "color": "#10B981"
                      },
                      {
                        "value": "NOT_AVAILABLE",
                        "color": "#94A3B8"
                      },
                      {
                        "value": "NOT_APPLICABLE",
                        "color": "#64748B"
                      },
                      {
                        "value": "ERROR",
                        "color": "#EF4444"
                      }
                    ]
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Measurement Status",
                "showDescription": true,
                "description": "How every check resolved against this workspace."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 4,
            "width": 4,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "tier_bars",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_tier",
                  "fields": [
                    {
                      "name": "n_checks",
                      "expression": "`n_checks`"
                    },
                    {
                      "name": "check_tier",
                      "expression": "`check_tier`"
                    },
                    {
                      "name": "outcome",
                      "expression": "`outcome`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "n_checks",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "check_tier",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "color": {
                  "fieldName": "outcome",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "Measured",
                        "color": "#10B981"
                      },
                      {
                        "value": "Nothing in scope",
                        "color": "#64748B"
                      },
                      {
                        "value": "Check ran, no data",
                        "color": "#F59E0B"
                      },
                      {
                        "value": "No check written",
                        "color": "#94A3B8"
                      },
                      {
                        "value": "Error",
                        "color": "#EF4444"
                      }
                    ]
                  }
                }
              },
              "mark": {
                "layout": "stack"
              },
              "frame": {
                "showTitle": true,
                "title": "Outcome by Check Tier",
                "showDescription": true,
                "description": "Tier is what a check needs to run: SYSTEM_TABLE is SQL over system.*, TABLE_DETAIL a per-object scan, WORKSPACE_API and ACCOUNT_API need REST, MANUAL needs a conversation. Green is measured; grey is a check nobody has written yet, which is the backlog."
              }
            }
          },
          "position": {
            "x": 4,
            "y": 4,
            "width": 8,
            "height": 7
          }
        },
        {
          "widget": {
            "name": "blindspot_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_blindspots",
                  "fields": [
                    {
                      "name": "severity",
                      "expression": "`severity`"
                    },
                    {
                      "name": "check_tier",
                      "expression": "`check_tier`"
                    },
                    {
                      "name": "category",
                      "expression": "`category`"
                    },
                    {
                      "name": "title",
                      "expression": "`title`"
                    },
                    {
                      "name": "reason",
                      "expression": "`reason`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "severity",
                    "displayName": "Severity",
                    "title": "Severity",
                    "order": 0,
                    "visible": true,
                    "alignContent": "left",
                    "type": "string",
                    "displayAs": "string"
                  },
                  {
                    "fieldName": "check_tier",
                    "displayName": "Tier",
                    "title": "Tier",
                    "order": 1,
                    "visible": true,
                    "alignContent": "left",
                    "type": "string",
                    "displayAs": "string"
                  },
                  {
                    "fieldName": "category",
                    "displayName": "Category",
                    "title": "Category",
                    "order": 2,
                    "visible": true,
                    "alignContent": "left",
                    "type": "string",
                    "displayAs": "string"
                  },
                  {
                    "fieldName": "title",
                    "displayName": "Check",
                    "title": "Check",
                    "order": 3,
                    "visible": true,
                    "alignContent": "left",
                    "type": "string",
                    "displayAs": "string"
                  },
                  {
                    "fieldName": "reason",
                    "displayName": "Why Not Measured",
                    "title": "Why Not Measured",
                    "order": 4,
                    "visible": true,
                    "alignContent": "left",
                    "type": "string",
                    "displayAs": "string"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Checks Without a Result",
                "showDescription": true,
                "description": "Ranked by severity - the CRITICAL rows matter most."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 11,
            "width": 12,
            "height": 11
          }
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "widgetHeaderAlignment": "LEFT"
    }
  }
}